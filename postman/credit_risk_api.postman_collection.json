  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "lastRequestId",
      "value": ""
    },
    {
      "key": "pdS2",
      "value": ""
    },
    {
      "key": "bigBatch",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Operations",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"model loaded\", () => pm.expect(pm.response.json().model_loaded).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Model info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/model",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "model"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"gender not a model feature\", () => pm.expect(pm.response.json().features).to.not.include(\"gender\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Prediction scenarios",
      "item": [
        {
          "name": "S1 - Low-risk applicant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "predict"
              ]
            },
            "description": "Stable civil servant, strong bureau scores.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application_id\": \"PM-LOW\",\n  \"applicant\": {\n    \"contract_type\": \"Cash loans\",\n    \"gender\": \"F\",\n    \"own_car\": false,\n    \"own_realty\": true,\n    \"children\": 0,\n    \"income\": 420000,\n    \"credit_amount\": 600000,\n    \"annuity\": 22000,\n    \"goods_price\": 550000,\n    \"income_type\": \"State servant\",\n    \"education\": \"Higher education\",\n    \"family_status\": \"Married\",\n    \"housing_type\": \"House / apartment\",\n    \"age_years\": 46,\n    \"years_employed\": 15,\n    \"occupation\": \"Core staff\",\n    \"family_members\": 2,\n    \"region_rating\": 1,\n    \"ext_source_1\": 0.75,\n    \"ext_source_2\": 0.78,\n    \"ext_source_3\": 0.8\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"PD within [0,1]\", () => pm.expect(j.prediction.probability_of_default).to.be.within(0, 1));",
                  "pm.test(\"has reasons\", () => pm.expect(j.explanation.reasons.length).to.be.above(0));",
                  "pm.test(\"latency < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "pm.collectionVariables.set(\"lastRequestId\", j.request_id);",
                  "pm.test(\"band is LOW_RISK\", () => pm.expect(pm.response.json().prediction.decision_band).to.eql(\"LOW_RISK\"));"
                ]
              }
            }
          ]
        },
